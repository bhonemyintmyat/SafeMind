{
	"name": "safemind",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "vite",
		"nlp": "python3 -u -m nlp_service.app",
		"nlp:fastapi": "python3 -u -m uvicorn nlp_service.fastapi_app:app --host 127.0.0.1 --port 5050",
		"test:nlp": "python3 -m unittest discover -s tests -v",
		"test:extension": "node scripts/validate-extension.mjs",
		"test:routes": "node scripts/validate-local-routes.mjs",
		"test:coach-no-key": "node scripts/validate-education-fallback.mjs",
		"test:coach-resilience": "node scripts/validate-education-resilience.mjs",
		"test:simple-scam": "node scripts/validate-simple-scam.mjs",
		"test:openrouter-scan": "node scripts/validate-openrouter-scan.mjs",
		"test:openrouter-live": "node scripts/validate-openrouter-live.mjs",
		"audit:translations": "node scripts/audit-translations.mjs",
		"build": "vite build",
		"build:all": "npm run build -- --emptyOutDir && npm run test:extension",
		"preview": "vite preview"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.49.1",
		"write-excel-file": "^4.1.1"
	},
	"devDependencies": {
		"vite": "^5.4.0"
	}
}
