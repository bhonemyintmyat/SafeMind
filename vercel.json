{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/src/pages/main.html", "destination": "/", "permanent": true },
    { "source": "/src/pages/index.html", "destination": "/", "permanent": true },
    { "source": "/src/pages/login.html", "destination": "/login", "permanent": true },
    { "source": "/src/pages/signup.html", "destination": "/signup", "permanent": true },
    { "source": "/src/pages/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/src/pages/reports.html", "destination": "/reports", "permanent": true },
    { "source": "/src/pages/education.html", "destination": "/eduai", "permanent": true },
    { "source": "/src/pages/education-article.html", "destination": "/eduai/article", "permanent": true },
    { "source": "/src/pages/profile.html", "destination": "/settings", "permanent": true },
    { "source": "/src/pages/onboarding.html", "destination": "/welcome", "permanent": true },
    { "source": "/src/pages/splash.html", "destination": "/intro", "permanent": true },
    { "source": "/src/pages/sitemap.html", "destination": "/sitemap", "permanent": true },
    { "source": "/src/pages/scam-checker.html", "destination": "/dashboard?view=investigation", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/src/pages/main.html" },
    { "source": "/login", "destination": "/src/pages/login.html" },
    { "source": "/signup", "destination": "/src/pages/signup.html" },
    { "source": "/dashboard", "destination": "/src/pages/dashboard.html" },
    { "source": "/reports", "destination": "/src/pages/reports.html" },
    { "source": "/eduai", "destination": "/src/pages/education.html" },
    { "source": "/eduai/article", "destination": "/src/pages/education-article.html" },
    { "source": "/settings", "destination": "/src/pages/profile.html" },
    { "source": "/welcome", "destination": "/src/pages/onboarding.html" },
    { "source": "/intro", "destination": "/src/pages/splash.html" },
    { "source": "/sitemap", "destination": "/src/pages/sitemap.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-write=(self)" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
