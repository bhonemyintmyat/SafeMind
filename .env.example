# Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

# Optional: omit this when the frontend and /api/spam-check share one origin.
# VITE_NLP_API_URL=https://api.example.com/api/spam-check

# Server-side only. Never expose this key through a VITE_ variable.
OPENROUTER_API_KEY=your-server-side-openrouter-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openrouter/free
# Conversational questions and follow-ups use Gemini first.
OPENROUTER_AGENT_MODEL=google/gemini-2.5-flash
# Burmese requests use Gemini first, then fall back to the standard route.
OPENROUTER_BURMESE_MODEL=google/gemini-2.5-flash
# Optional comma-separated fallback route, for example: model-a,model-b
OPENROUTER_MODELS=

# Optional: omit when the Education page and API share one origin.
# VITE_EDUCATION_API_URL=https://api.example.com/api/education-chat
